{
  "rules": {
    ".read": false,
    ".write": false,
    "gag": {
      "names": {
        "$name": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString() && newData.val() === auth.uid && $name.length >= 3 && $name.length <= 16"
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "name": {
            ".read": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "garden": {
            "z": { ".validate": "newData.isString() && newData.val().length <= 400000" }
          },
          "friends": {
            "$friend": {
              ".write": "auth != null && (auth.uid === $uid || (auth.uid === $friend && (root.child('gag/requests').child(auth.uid).child($uid).exists() || !newData.exists() )))",
              ".validate": "newData.isString() && newData.val().length <= 16"
            }
          }
        }
      },
      "requests": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          "$from": {
            ".write": "auth != null && (auth.uid === $from || auth.uid === $to)",
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        }
      },
      "where": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "rooms": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && (data.child('mem').child(auth.uid).exists() || newData.child('mem').child(auth.uid).exists())",
          "mem": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren() ? true : !newData.exists()",
            "$member": { ".validate": "newData.isString() && newData.val().length <= 16" }
          },
          "s": {
            "z": { ".validate": "newData.isString() && newData.val().length <= 400000" }
          }
        }
      },
      "v": {
        "$server": {
          ".read": "auth != null",
          "p": {
            "$uid": { ".write": "auth != null" }
          },
          "m": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          },
          "g": {
            "$owner": {
              ".write": "auth != null && auth.uid === $owner",
              "need": {
                "$uid": { ".write": "auth != null && auth.uid === $uid" }
              },
              "s": {
                "z": { ".validate": "newData.isString() && newData.val().length <= 400000" }
              }
            }
          }
        }
      },
      "vi": {
        ".read": "auth != null",
        "$server": {
          "$uid": { ".write": "auth != null" }
        }
      }
    }
  }
}
